# Environment Configuration
ENVIRONMENT=development
DEBUG=True

# Database Configuration (PostgreSQL in production, SQLite fallback for quick local testing)
# Example Postgres:
# DATABASE_URL=postgresql+asyncpg://belvo_user:secret_password@localhost:5432/belvo_synapse
# SYNC_DATABASE_URL=postgresql+psycopg2://belvo_user:secret_password@localhost:5432/belvo_synapse
DATABASE_URL=sqlite+aiosqlite:///./belvo_synapse.db
SYNC_DATABASE_URL=sqlite:///./belvo_synapse.db

# Security & JWT
SECRET_KEY=change-this-to-a-very-secure-random-key-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Site Metadata
BASE_URL=https://belvosynapse.com
OFFICIAL_EMAIL=contact@belvoventures.com

# AI Benchmark API Keys (Optional - For automated Visibility Dashboard querying)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
